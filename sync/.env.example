# 复制本文件为 .env（同目录），填入你的 service_role key。
# service_role key 有完全读写权限，等同于数据主密钥，切勿提交到 git 或泄露。

# 必填：Supabase service_role key
# 位置：Supabase 控制台 → Project Settings → API → service_role（secret）
JOHN_SUPABASE_SERVICE_KEY=sb_secret_替换为你的key

# 以下为可选，默认值已内置在脚本中：
# JOHN_SUPABASE_URL=https://oofqbmlpfrhiothxkjiy.supabase.co
# JOHN_OBSIDIAN_VAULT=D:\Users\76114\Obsidian Vault
# JOHN_SYNC_INTERVAL=15000
